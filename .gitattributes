# ─────────────────────────────────────────────────────────────
# Cross-platform consistency. Normalize to LF in the repo;
# checkout native. Prevents CRLF/LF churn between Windows/macOS/Linux.
# ─────────────────────────────────────────────────────────────

# Default: auto-detect text, store as LF
* text=auto eol=lf

# ── Source / text (explicit) ──
*.ts     text
*.tsx    text
*.js     text
*.jsx    text
*.mjs    text
*.cjs    text
*.json   text
*.jsonc  text
*.css    text
*.scss   text
*.html   text
*.md     text
*.mdx    text
*.py     text
*.pyi    text
*.sql    text
*.yml    text
*.yaml   text
*.toml   text
*.ini    text
*.cfg    text
*.env    text
*.svg    text
Dockerfile        text
*.Dockerfile      text
.gitignore        text
.gitattributes    text
.dockerignore     text

# Shell scripts must stay LF even on Windows checkout
*.sh     text eol=lf

# ── Binary (never diff / never normalize) ──
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.parquet binary
*.pkl    binary
*.joblib binary
*.pt     binary
*.onnx   binary

# ── Lockfiles: text, but suppress noisy diffs ──
pnpm-lock.yaml   -diff
*.lock           -diff
