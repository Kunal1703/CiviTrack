# ─────────────────────────────────────────────────────────────
# ML service environment. Copy to `.env` for local runs.
# In Docker Compose these are injected by the compose file.
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Path to the HuggingFace model artifact directory (save_pretrained output).
# Local run: point at the trained artifact. In Compose: mounted at /model.
MODEL_DIR=../../ml/models/classification/artifacts/transformer
MODEL_VERSION=classifier-v1.0
MAX_LENGTH=32
TOP_K=3
