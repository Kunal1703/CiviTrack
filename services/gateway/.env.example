# ─────────────────────────────────────────────────────────────
# API Gateway environment. Copy to `.env` for local (non-Docker) runs.
# In Docker Compose these are injected by the compose file instead.
# `.env` is git-ignored; this template is committed.
# ─────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=development       # development | staging | production
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# PostgreSQL (host=localhost for local runs; =postgres inside Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=civitrack
POSTGRES_PASSWORD=civitrack_dev_pw
POSTGRES_DB=civitrack
