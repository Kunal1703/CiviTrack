# ─────────────────────────────────────────────────────────────
# Infrastructure environment (Docker Compose)
# Copy to `.env` in this directory and adjust for your machine.
# `.env` is git-ignored; `.env.example` is committed as the template.
# ─────────────────────────────────────────────────────────────

# PostgreSQL superuser + primary database
POSTGRES_USER=civitrack
POSTGRES_PASSWORD=civitrack_dev_pw   # dev-only; use a secret manager in prod
POSTGRES_DB=civitrack

# Host port to expose Postgres on (container always listens on 5432 internally).
# Defaults to 5433 to avoid clashing with a native Postgres on 5432.
POSTGRES_HOST_PORT=5433

# ── API Gateway (FastAPI) ──
GATEWAY_PORT=8000
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=INFO

# HuggingFace cache dir (host) mounted into ml_service for the embedding model
HF_CACHE=C:/Users/kunal/.cache/huggingface
