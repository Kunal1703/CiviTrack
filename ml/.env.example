# ─────────────────────────────────────────────────────────────
# Data pipeline environment (host runs). Copy to `.env`.
# The pipeline runs on the host and connects to the Postgres CONTAINER via its
# mapped host port (5433 by default — see infra/docker-compose.yml).
# `.env` is git-ignored; this template is committed.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (host-side: localhost + mapped host port)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=civitrack
POSTGRES_PASSWORD=civitrack_dev_pw
POSTGRES_DB=civitrack

# Optional Socrata app token (raises API rate limits; not required for M0)
# APP_TOKEN=

# Bounded development dataset (override defaults if desired)
# FETCH_LIMIT=50000
# SINCE_DATE=2024-01-01T00:00:00
